# VX-RAG Environment Configuration Example
# Copy this file to .env and customize for your environment
# WARNING: Never commit .env file with real credentials to version control

# Python Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
# MCP Server Configuration
# Transport mode: stdio | http | sse
MCP_TRANSPORT=stdio
MCP_PORT=8000
MCP_HOST=0.0.0.0
CONFIG_PATH=./config/settings.yaml

# RAG Configuration
# Embedding model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# Retrieval configuration
TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid search weights (BM25 + Vector)
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# Vector Store Configuration (FAISS)
FAISS_INDEX_TYPE=HNSW
FAISS_HNSW_M=32
FAISS_HNSW_EF_CONSTRUCTION=200
FAISS_HNSW_EF_SEARCH=128

# Data Paths
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
INDEX_DIR=./data/index
SNAPSHOTS_DIR=./data/snapshots
LOGS_DIR=./logs

# Logging Configuration
LOG_LEVEL=INFO
LOG_STRUCTURED=false
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Performance Configuration
WORKER_THREADS=4
BATCH_SIZE=32
USE_GPU=false
CUDA_DEVICE=0

# Security Configuration
# CORS settings (for HTTP/SSE modes)
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# External API Keys (Optional)
# AI API key (for external LLM integration)
AI_API_KEY=

# HuggingFace token (for accessing private models)
HF_TOKEN=

# Slack webhook for error notifications (optional)
# SLACK_WEBHOOK_URL=

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# Development Configuration
DEBUG=false
HOT_RELOAD=false
ENABLE_PROFILING=false

# PDF Scraper Script Configuration
CHROMIUM_PATH=/path/to/chrome.exe
CHROMEDRIVER_PATH=/path/to/chromedriver.exe
CHROME_USER_DATA_DIR=/path/to/chrome/user/data
CHROME_PROFILE=Profile 1
PDF_LIMIT=100
DEBUG_LOGS_DIR=scripts/debug_logs
DEBUG_LOG_FILE=scripts/debug.log
SELENIUM_TIMEOUT=10
OUTPUT_FILE=pdf_index.json