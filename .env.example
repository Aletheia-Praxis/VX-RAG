# Environment variables for VX-RAG system
# Copy this file to .env and fill in your values


# Scope of application: General configuration for VX-RAG system

# AI API key (optional, for external LLM integration)
AI_API_KEY=

# HuggingFace token (optional, for accessing private models)
HF_TOKEN=

# Data directories
DATA_DIR=data
INDEX_DIR=data/index
PROCESSED_DIR=data/processed
RAW_DIR=data/raw

# Embedding model configuration
EMBEDDING_MODEL=...

# Server configuration
HOST=0.0.0.0
PORT=8000


# Scope of application: Script designed to get PDF

CHROMIUM_PATH=/path/to/chrome.exe
CHROMEDRIVER_PATH=/path/to/chromedriver.exe
CHROME_USER_DATA_DIR=/path/to/chrome/user/data
CHROME_PROFILE=Profile 1
PDF_LIMIT=100
DEBUG_LOGS_DIR=scripts/debug_logs
DEBUG_LOG_FILE=scripts/debug.log
SELENIUM_TIMEOUT=10
OUTPUT_FILE=pdf_index.json